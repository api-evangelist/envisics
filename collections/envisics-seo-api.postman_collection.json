          "id": "4582d98c-0ba5-4509-b3fd-8d9b1dbbacb2",
          "name": "Get SEO head metadata for an envisics.com URL",
          "request": {
            "name": "Get SEO head metadata for an envisics.com URL",
            "description": {
              "content": "Return the rendered <head> metadata for a URL on envisics.com, plus a parsed JSON object carrying the title, robots directives, canonical, Open Graph and Twitter tags and the schema.org JSON-LD graph.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "yoast",
                "v1",
                "get_head"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) The envisics.com URL to return head metadata for."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
